https://javacc.github.io/javacc/documentation/grammar.html
*/

options{
  IGNORE_CASE = true; // para que no importe mayusculas o min
  STATIC = false; // instanciar el parser con new AuraParser
}

/* -------- aqui comienza el PARSER */
PARSER_BEGIN(AuraParser)
import java.io.*; // para manejar i/o y archivos
import java.nio.charset.StandardCharsets;
import java.util.*;

public class AuraParser
{
    // mensaje de error para lector de pantalla
    static String describir(Token t)
    {
      if (t.kind == AuraParserConstants.NEWL) return "salto de linea";
      if (t.kind == AuraParserConstants.EOF)  return "fin del archivo";
      return "'" + t.image + "'";
    }

    public static void main(String[] args) throws Exception
    {
      System.out.println("Aura v1.0");
      System.out.println("Leyendo codigo fuente...");
      try
      {
	// se lee todo y se agrega un salto final para que la ultima instruccion quede terminada
      	String fuente = new String(System.in.readAllBytes(), StandardCharsets.UTF_8) + "\n";

        AuraParser parser = new AuraParser(new StringReader(fuente));
        parser.Init(); // evaluación sintactica

        System.out.println("Se compilo de forma exitosa sin ningun error :D"); 
       
      } // mejora de errores para el lector de pantalla
      catch (ParseException e)
      {
	Token n = e.currentToken.next;
        // System.out.println("Error Sintactico:" + e.getMessage());
	System.out.println("Error sintactico en linea " + n.beginLine + ", columna "
                          + n.beginColumn + ": no se esperaba " + describir(n));
      }
      catch (TokenMgrError e)
      {
        System.out.println("Error Lexico:" + e.getMessage()); 
      }

    }
}

PARSER_END(AuraParser)

/*------------- comienzo de analisis lexico */

//bloque SKIP, se ignoran espacios, tabuladores y retornos
SKIP: { " " | "\t" | "\r" }

// palabras reservadas

// javacc asigna la prioridad segun el orden de aparicion en el archivo, ademas, las etiquetas de los tokens deben seguir las reglas de identificadores (comenzar con una letra o un guión bajo)

TOKEN: {
    // palabras reservadas, tokenizacion

    // acciones  y sus atajo
    < CIFR  : "cifrar"      | "cif"       >
|   < DESC  : "descifrar"   | "dcif"      >
|   < CODI  : "codificar"   | "cod"       >
|   < DECO  : "decodificar" | "dcod"      >
|   < PROB  : "probar"                    >
|   < FIN   : "fin"                       >

    // campos con palabras
|   < TEXTO : "texto"                     >
|   < CLAV  : "clave"                     >
|   < RESUL : "resultado"                 >


    // campos siguiendo la formula de cifrado
|   < LET_M : "m"                         >
|   < LET_K : "k"                         >
|   < LET_C : "c"                         >

    // salida
|   < GUAR  : "guardar"     | "guar"      >
|   < IMPR  : "imprimir"    | "impr"      >
|   < EN    : "en"                        >
|   < ARCH  : "archivo"     | "arch"      >

    // nombres de algoritmos vigentes (actualizado jeje)
|   < AES128: "aes128"                    >
|   < AES256: "aes256"                    >
|   < CHACHA: "chacha20"                  >
|   < CESAR : "cesar"                     >
|   < VIGNR : "vigenere"                  >
|   < XOR   : "xor"                       >
|   < BASE64: "base64"                    >

    // delimitador principal que reemplaza el punto y coma para facilidad de codificacion para las personas en situación de discapacidad
|   < NEWL  : "\n"                        > 

    // literales
|   < NUM   : (["0"-"9"])+                >
|   < STRING: "'" (~["'","\n","\r"])* "'" >

    // nombre de identificador o funcion, siempre al final
|   < ID:   (["a"-"z", "A"-"Z", "_"])(["a"-"z", "A"-"Z", "_", "0"-"9"])* >
}

// reconocer los comentarios de línea que inician con ; 
SPECIAL_TOKEN: {
    < COMM_LIN : ";" (~["\n","\r"])*      >   // ya no se come el salto de linea
}

/*---------------- analisis sintactico */

// procesar instrucciones hasta llegar al final del archivo(EOF)

// se puso casi todo en una función para que lo podamos leer mejor
void Saltos(): {}
{
  ( <NEWL> )+
}

void Init(): {}
{
  ( <NEWL> )*
  ( Sentencia() )*
  <EOF>
}

void Sentencia(): {}
{
    BloqueCifrado() // reconocer bloques de cifrado
  | BloqueDescifrado() // -- bloques de descifrado
  | BloqueCodificar()// lo mismo pero para codificar y decodificar
  | BloqueDecodificar()
  | ComandoProbar()
  | ComandoImprimir()
  | ComandoGuardar()
}

// reconocer bloques de cifrado tipo cif aes256 y asi
void BloqueCifrado(): {}
{
  <CIFR> AlgoritmoCifrado() Saltos()
  (
      ( <TEXTO> | <LET_M> ) Valor() Saltos()
    | ( <CLAV>  | <LET_K> ) Valor() Saltos()
    | ( <RESUL> | <LET_C> ) <ID>   Saltos()
  )*
  <FIN> ( <CIFR> )? Saltos()
}

// reconocer bloques de descifrado tipo dcif aes256
void BloqueDescifrado(): {}
{
  <DESC> AlgoritmoCifrado() Saltos()
  (
      ( <TEXTO> | <LET_C> ) Valor() Saltos()
    | ( <CLAV>  | <LET_K> ) Valor() Saltos()
    | ( <RESUL> | <LET_M> ) <ID>   Saltos()
  )*
  <FIN> ( <DESC> )? Saltos()
}

// base64 es codificacion, no cifrado
void BloqueCodificar(): {}
{
  <CODI> <BASE64> Saltos()
  (
      ( <TEXTO> | <LET_M> ) Valor() Saltos()
    | ( <RESUL> | <LET_C> ) <ID>   Saltos()
  )*
  <FIN> ( <CODI> )? Saltos()
}

void BloqueDecodificar(): {}
{
  <DECO> <BASE64> Saltos()
  (
      ( <TEXTO> | <LET_C> ) Valor() Saltos()
    | ( <RESUL> | <LET_M> ) <ID>   Saltos()
  )*
  <FIN> ( <DECO> )? Saltos()
}

//reconocer el algoritmo seleccionado
void AlgoritmoCifrado(): {}
{
  <AES128> | <AES256> | <CHACHA> | <CESAR> | <VIGNR> | <XOR>
}

// fuerza bruta de cesar, probar cesar mensaje
void ComandoProbar(): {}
{
  <PROB> <CESAR> Valor() Saltos()
}

// enviar a pantalla o lector de voz
void ComandoImprimir(): {}
{
  <IMPR> Valor() Saltos()
}

// guardar en archivo nombre
void ComandoGuardar(): {}
{
  <GUAR> Valor() ( <EN> <ARCH> Valor() )? Saltos()
}

void Valor(): {}
{
  <STRING> | <ID> | <NUM>
}