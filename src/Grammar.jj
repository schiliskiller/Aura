*/

options{
  IGNORE_CASE = true; // para que no importe mayusculas o min
  STATIC = false; // instanciar el parser con new AuraParser
}

/* -------- aqui comienza el PARSER */
PARSER_BEGIN(AuraParser)
import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.util.*;
import javax.swing.JFileChooser;
import javax.swing.filechooser.FileNameExtensionFilter;

public class AuraParser
{
    /*
      las diapositivas dicen que un compilador no solo debe detectar errores, sino reportar
      de forma clara al usuario, es por eso que este método traduce identificadores a espaniol
      para que el usuario entienda que fue lo que falló

      se revisó la documentacion de javacc sobre la clase Token
      t.kind guarda el tipo de token y se hizo un if sencillo de constantes
      de AuraParserConstants para checar si es NEWL o EFO antes de imprimir
      con t.image
    */
    
    static String describir(Token t)
    {
      if (t.kind == AuraParserConstants.NEWL) return "salto de linea";
      if (t.kind == AuraParserConstants.EOF)  return "fin del archivo";
      return "'" + t.image + "'";
    }

    // main
    public static void main(String[] args) throws Exception
    {
      File archivo_seleccionado= null;

      //para hacer seleccion del archivo en terminal o gui
      if(args.length > 0)
      {
        archivo_seleccionado = new File(args[0]);
        System.out.println("Uso por terminal...");
      }
      else
      {
        // por si se va a ocupar el GUI, se abrira el selector de archivos
        System.out.println("Uso por GUI");
        try
        {
          // basado desde Guia de Uso: El Proyecto CompiladorGO proporcionado con el manual

          JFileChooser fileChooser = new JFileChooser();
          FileNameExtensionFilter filter = new FileNameExtensionFilter("Archivos Aura (*.aura, *.txt)", "aura", "txt");
          fileChooser.setFileFilter(filter);

          int returnValue = fileChooser.showOpenDialog(null);
          if (returnValue == JFileChooser.APPROVE_OPTION)
          {
            archivo_seleccionado = fileChooser.getSelectedFile();
          }
          else
          {
            System.out.println("Operacion cancelada: no se selecciono ningun archivo");
            System.out.println("Saliendo de Aura....");
            return;
          }
        }
        // fin intentar de abrir archivo desde gui jsjsj
        catch(java.awt.HeadlessException e)
        {
          System.err.println(e);
          return;
        }
      }
        // abrir el archivo
        String fileName = archivo_seleccionado.getAbsolutePath();
        System.out.println("Aura v1.0");
        System.out.println("Archivo: " + fileName + "\n");

        String[] extension = fileName.split("\\.");

        if(!extension[1].equals("aura"))
        {
         // System.out.println(extension[1]);
          System.out.println("Error: el archivo no es un .aura o un .txt");
          System.out.println("Saliendo de Aura...");
          return;

        }

        // si todo sale bien, ahora si compila jejej
        System.out.println("Leyendo codigo fuente...");

        // se lee todo y se agrega un salto final para que la ultima instruccion quede terminada
        String fuente = new String(Files.readAllBytes(archivo_seleccionado.toPath()), StandardCharsets.UTF_8);

        try
        {
          // analisis lexico
          AuraParserTokenManager lexer = new AuraParserTokenManager(new SimpleCharStream(new StringReader(fuente)));
          Token token;
          int count = 1;

          while ((token = lexer.getNextToken()).kind != AuraParserConstants.EOF)
          {
            // adaptado para lectura por voz y línea Braille
            System.out.println("Token " + count + ": " + describir(token) + " en Linea " + token.beginLine + ", Columna " + token.beginColumn + ".");
            count++;
          }

          // seimprime el fin de archivo para accesibilidad
          System.out.println("Token " + count + ": " + describir(token) + " en Linea " + token.beginLine + ", Columna " + token.beginColumn + ".");

          // analisis sintactico:
          // instanciar parser generado por javacc
          AuraParser parser = new AuraParser(new StringReader(fuente));
          parser.Init(); // evaluación sintactica

          System.out.println("Se compilo de forma exitosa sin ningun error :D"); 
       
        }
        /* manejo de errores para el lector de pantalla,
           segun las diapositivas, el compilador debe detectar, reportar(con línea y columba), recuperar
           sin colapsar  y mostrar un informe
        */        
        catch (ParseException e)
        {
         // errores sintacticos

         Token n = e.currentToken.next;
         // System.out.println("Error Sintactico:" + e.getMessage());
	       System.out.println("Error sintactico en linea " + n.beginLine + ", columna "
                          + n.beginColumn + ": no se esperaba " + describir(n));
        }
        catch (TokenMgrError e)
        {
         // errores lexicos 
         System.out.println("Error Lexico:" + e.getMessage()); 
        }
    }
}

PARSER_END(AuraParser)

/*------------- comienzo de analisis lexico */

//bloque SKIP, se ignoran espacios, tabuladores y retornos

<DEFAULT> SKIP:
{
  " "   // espacio
| "\t"  // tabulador
| "\r"  // retorno de carro
}

// palabras reservadas

// javacc asigna la prioridad segun el orden de aparicion en el archivo, ademas, las etiquetas de los tokens deben seguir las reglas de identificadores (comenzar con una letra o un guión bajo)

TOKEN: {
    // palabras reservadas, tokenizacion

    // acciones  y sus atajo
    < CIFR  : "cifrar"      | "cif"       >
|   < DESC  : "descifrar"   | "dcif"      >
|   < CODI  : "codificar"   | "cod"       >
|   < DECO  : "decodificar" | "dcod"      >
|   < PROB  : "probar"                    >
|   < HUELLA: "huella"      | "h"         >
|   < IDENT : "identificar" | "ident"     >
|   < FIN   : "fin"                       >

    // campos con palabras
|   < TEXTO : "texto"                     >
|   < CLAV  : "clave"                     >
|   < RESUL : "resultado"                 >


    // campos siguiendo la formula de cifrado
|   < LET_M : "m"                         >
|   < LET_K : "k"                         >
|   < LET_C : "c"                         >

    // salida
|   < GUAR  : "guardar"     | "guar"      >
|   < IMPR  : "imprimir"    | "impr"      >
|   < EN    : "en"                        >
|   < ARCH  : "archivo"     | "arch"      >

    // nombres de algoritmos vigentes (actualizado jeje)
|   < AES128: "aes128"                    >
|   < AES256: "aes256"                    >
|   < CHACHA: "chacha20"                  >
|   < CESAR : "cesar"                     >
|   < VIGNR : "vigenere"                  >
|   < XOR   : "xor"                       >
|   < BASE64: "base64"                    >
|   < SHA256: "sha256"                    >
|   < SHA512: "sha512"                    >
|   < SHA3  : "sha3"                      >

    // delimitador principal que reemplaza el punto y coma para facilidad de codificacion para las personas en situación de discapacidad
|   < NEWL  : "\n"                        >
|   < PUNTO : "."                         >

    // literales, expresiones regulares sin etiquetas auxiliares
|   < NUM   : (["0"-"9"])+                >
|   < STRING: "'" (~["'","\n","\r"])* "'" >

    // nombre de identificador o funcion, siempre al final
|   < ID:   (["a"-"z", "A"-"Z", "_"])(["a"-"z", "A"-"Z", "_", "0"-"9"])* >
}

// reconocer los comentarios de línea que inician con ; 
SPECIAL_TOKEN: {
    < COMM_LIN : ";" (~["\n","\r"])*      >   // ya no se come el salto de linea
}

/*---------------- analisis sintactico (gramática/parser) */
// https://www.scribd.com/document/260675669/javaccparse2
// procesar instrucciones hasta llegar al final del archivo(EOF)
// aqui van las GLC

// inicio del arbol, es S
void Init(): {} // No terminales
{ 
  ( <NEWL> )*
  ( Sentencia() )*
  <PUNTO>
  ( <NEWL> )*
  <EOF>
}

// para que lo podamos leer mejor
void Saltos(): {}
{
  ( <NEWL> )+
}

void Sentencia(): {} // No terminales
{
    BloqueCifrado() // reconocer bloques de cifrado
  | BloqueDescifrado() // -- bloques de descifrado
  | BloqueCodificar()// lo mismo pero para codificar y decodificar
  | BloqueDecodificar()
  | BloqueHuella() // crear hash/huella
  | ComandoIdentificar() //identificar hash/huella
  | ComandoProbar()
  | ComandoImprimir()
  | ComandoGuardar()
}

// No terminales
// reconocer bloques de cifrado tipo cif aes256 y asi
void BloqueCifrado(): {}
{
  <CIFR> AlgoritmoCifrado() Saltos()
  (
      ( <TEXTO> | <LET_M> ) Valor() Saltos()
    | ( <CLAV>  | <LET_K> ) Valor() Saltos()
    | ( <RESUL> | <LET_C> ) <ID>   Saltos()
  )*
  <FIN> ( <CIFR> )? Saltos()
}

// reconocer bloques de descifrado tipo dcif aes256
void BloqueDescifrado(): {}
{
  <DESC> AlgoritmoCifrado() Saltos()
  (
      ( <TEXTO> | <LET_C> ) Valor() Saltos()
    | ( <CLAV>  | <LET_K> ) Valor() Saltos()
    | ( <RESUL> | <LET_M> ) <ID>   Saltos()
  )*
  <FIN> ( <DESC> )? Saltos()
}

// base64 es codificacion, no cifrado
void BloqueCodificar(): {}
{
  <CODI> <BASE64> Saltos()
  (
      ( <TEXTO> | <LET_M> ) Valor() Saltos()
    | ( <RESUL> | <LET_C> ) <ID>   Saltos()
  )*
  <FIN> ( <CODI> )? Saltos()
}

void BloqueDecodificar(): {}
{
  <DECO> <BASE64> Saltos()
  (
      ( <TEXTO> | <LET_C> ) Valor() Saltos()
    | ( <RESUL> | <LET_M> ) <ID>   Saltos()
  )*
  <FIN> ( <DECO> )? Saltos()
}

void BloqueHuella(): {}
{
  <HUELLA> AlgoritmoHash() Saltos()
  (
      ( <TEXTO> | <LET_M> ) Valor() Saltos()
    | ( <RESUL> | <LET_C> ) <ID>    Saltos()
  )*
  <FIN> ( <HUELLA> )? Saltos()
}

void AlgoritmoHash(): {}
{
  <SHA256> | <SHA512> | <SHA3>
}

// identificar el algoritmo
void ComandoIdentificar(): {}
{
  <IDENT> Valor() Saltos()
}

//reconocer el algoritmo seleccionado
void AlgoritmoCifrado(): {}
{
  <AES128> | <AES256> | <CHACHA> | <CESAR> | <VIGNR> | <XOR>
}

// fuerza bruta de cesar, probar cesar mensaje
void ComandoProbar(): {}
{
  <PROB> <CESAR> Valor() Saltos()
}

// enviar a pantalla o lector de voz
void ComandoImprimir(): {}
{
  <IMPR> Valor() Saltos()
}

// guardar en archivo nombre
void ComandoGuardar(): {}
{
  <GUAR> Valor() ( <EN> <ARCH> Valor() )? Saltos()
}

void Valor(): {}
{
  <STRING> | <ID> | <NUM>
}