PARSER_BEGIN(AuraParser)
public class AuraParser
{
    public static void main(String[] args) throws ParseException
    {

    }
}
PARSER_END(AuraParser)

TOKEN: {
    // palabras reservadas
    < OPER: "operacion" > |
    < FIN:  "fin"       > |
    < USAR: "usar"      > |
    < ENTR: "entrada"   > |
    < CLAV: "clave"     > |
    < SALI: "salida"    > |
    < ALGR: "algoritmo" > |
    < GUAR: "guardar"   > |
    < IMPR: "imprimir"  > |
    // reemplaza el punto y coma para facilidad de codificacion
    < NEWL: "\n"        > |
    // nombre de identificador o funcion
    < ID:   (["a"-"z", "A"-"Z", "_"])(["a"-"z", "A"-"Z", "_", "0"-"9"])* >
}

SPECIAL_TOKEN: {
    // comentario de linea
    < COMM_LIN: ";" (~["\n","\r"])*("\n"|"\r"|"\r\n"|"\n\r") >
}

// excluye caracteres especificos al compilar
SKIP: { " " | "\t" }

void Init(): {}
{
    ""
}

void Usar(): {Token t;}
{
    t=<USAR> Func() {
        System.out.println("Operacion usada: " + t.image);
    }
}

// aqui se determina el algoritmo de encriptacion (AES, DES, 3DES, ChaCha20, etc.)
void Func(): {Token t;}
{
    <OPER>
}
